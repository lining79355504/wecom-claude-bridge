# ===== 企微智能机器人 =====
# 获取位置：企业微信管理后台 → 应用管理 → 智能机器人 → 选中机器人 → 开发设置
# 注意：这里是「智能机器人」的 Secret，不是自建应用的 Secret
WECOM_BOT_ID=
WECOM_BOT_SECRET=

# ===== 访问白名单（必填）=====
# 只有这些 userid 能让机器人驱动 Claude。多个用英文逗号分隔。
# 不知道自己的 userid：先留空启动一次，给它发条消息，日志里会打印「拒绝非白名单用户: xxx」。
WECOM_ALLOWED_USER_IDS=

# ===== Claude Code 工作目录（必填）=====
# 必须是具体仓库目录的绝对路径，不要用 ~ 或 /
# 故意不提供默认值：静默回退到当前目录会导致 Claude 改错仓库
CLAUDE_WORKSPACE=/Users/mort/Downloads/wecom-claude-bridge

# ===== 可访问目录围栏 =====
# Claude 只能在这些目录内读写；不在列表里的路径会被直接拦截（连审批机会都没有）。
# 留空 = 只允许 CLAUDE_WORKSPACE 本身。
# 需要同时操作多个仓库时用逗号分隔，例如：
#   CLAUDE_ALLOWED_PATHS=/Users/mort/Downloads/wecom-claude-bridge,/Users/mort/projects
# 设为 * 表示不限制（不推荐）
CLAUDE_ALLOWED_PATHS=

# ===== 可选调优 =====
# default = 原有人工审批；acceptEdits = 自动接受编辑；auto = Claude 自动判断
# auto 无法决定时仍会请求人工审批；可用性取决于模型、账号及组织策略。
CLAUDE_PERMISSION_MODE=default
# 单轮对话最多 agent 圈数（防死循环），默认 30
CLAUDE_MAX_TURNS=30
# 工单数据库路径，留空使用桥接项目下 data/tickets.sqlite
# 工单、消息和 Claude sessionId 持久保存；无需额外服务
TICKET_DB_PATH=
# 定时任务、执行记录和待发送结果也保存在上述 SQLite 数据库。
# 不同定时任务独立并发；超过上限的任务按顺序排队，同一任务不重叠。
SCHEDULE_CONCURRENCY=4
# 定时任务每次最多 agent 轮数（1–1000），独立于普通工单 CLAUDE_MAX_TURNS。
SCHEDULE_MAX_TURNS=100
# 推送使用独立并发池，不占 Claude 执行槽位。
SCHEDULE_DELIVERY_CONCURRENCY=4
# 单次定时执行超时（毫秒），含审批等待，默认 30 分钟。
SCHEDULE_TIMEOUT_MS=1800000
# daily 规则默认时区；命令可用 --timezone 单独指定。
SCHEDULE_TIMEZONE=Asia/Shanghai
# 会话内存缓存空闲回收时间（毫秒）；工单上下文仍可从数据库恢复
SESSION_TTL_MS=1800000
# 审批等待超时（毫秒），超时自动拒绝，默认 5 分钟
APPROVAL_TIMEOUT_MS=300000

# ===== 工具策略 =====
# 直接放行、不需要审批的只读工具（逗号分隔）
# 想更严格就把 Bash 从列表里去掉——但注意 Bash 本来就在审批范围内
READ_ONLY_TOOLS=Read,Glob,Grep,LS,NotebookRead,WebFetch,WebSearch,TodoWrite,Task

# 任何情况下都禁止的工具（逗号分隔）
DENIED_TOOLS=

# Bash 的纯只读命令（ls / cat / grep / git status / find …）不再弹审批，直接执行。
# 判定不了的（rm / git push / 重定向 / 命令替换 / 未识别的命令）仍然走审批。
# 置为 false 恢复「所有 Bash 都要审批」。判定规则见 src/bash-policy.js
BASH_READONLY_AUTO_APPROVE=true
